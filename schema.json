{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto-strategiebriefing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "valid_until", "status", "market", "assets", "events", "chaos_windows", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "degraded"]},
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "confidence", "risk_level", "breadth", "sentiment", "themes", "summary_nl"],
      "properties": {
        "regime": {"enum": ["bull", "bear", "sideways"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_level": {"enum": ["low", "elevated", "high", "extreme"]},
        "breadth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bull", "bear", "sideways"],
          "properties": {
            "bull": {"type": "integer", "minimum": 0},
            "bear": {"type": "integer", "minimum": 0},
            "sideways": {"type": "integer", "minimum": 0}
          }
        },
        "sentiment": {"type": "integer", "minimum": -2, "maximum": 2},
        "themes": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 60}},
        "summary_nl": {"type": "string", "maxLength": 400}
      }
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z0-9]+_USD$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regime", "trend_strength", "volatility", "risk_level", "confidence", "tradable", "notes"],
        "properties": {
          "regime": {"enum": ["bull", "bear", "sideways"]},
          "trend_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "volatility": {"enum": ["low", "normal", "high", "extreme"]},
          "risk_level": {"enum": ["low", "elevated", "high", "extreme"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "tradable": {"type": "boolean"},
          "notes": {"type": "string", "maxLength": 200},
          "indicators": {"type": "object"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_utc", "title", "importance", "assets", "source"],
        "properties": {
          "time_utc": {"type": "string", "format": "date-time"},
          "title": {"type": "string", "maxLength": 150},
          "importance": {"enum": ["low", "medium", "high"]},
          "assets": {"type": "array", "items": {"type": "string", "pattern": "^([A-Z0-9]+_USD|ALL)$"}},
          "source": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "chaos_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_utc", "end_utc", "assets", "reason"],
        "properties": {
          "start_utc": {"type": "string", "format": "date-time"},
          "end_utc": {"type": "string", "format": "date-time"},
          "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^([A-Z0-9]+_USD|ALL)$"}},
          "reason": {"type": "string", "maxLength": 150}
        }
      }
    },
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
  }
}
